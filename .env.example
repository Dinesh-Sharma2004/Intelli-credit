# Environment Variables Configuration
# Copy this to .env and fill in your values

# Backend Configuration
PYTHONUNBUFFERED=1
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration
DATABASE_URL=postgresql://intelli_credit:secure_password_123@postgres:5432/intelli_credit_db

# Vector Database
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Node Environment
NODE_ENV=development

# ML Model Configuration
MODEL_TYPE=xgboost
MODEL_VERSION=v2.1.0
ENABLE_SHAP_EXPLANATIONS=true

# OCR Configuration
OCR_ENGINE=tesseract
CONFIDENCE_THRESHOLD=0.80

# Feature Flags
ENABLE_WEB_SCRAPING=true
ENABLE_MCA_INTEGRATION=true
ENABLE_LITIGATION_SEARCH=true
ENABLE_SECTOR_ANALYSIS=true
