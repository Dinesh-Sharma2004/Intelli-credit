# Configuration Example for Multilingual Document Processing Pipeline

# ============================================================================
# .env FILE EXAMPLE - Backend Configuration
# ============================================================================
# Copy this to backend/.env and modify values for your environment

# DATABASE CONFIGURATION
# =====================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/intelli_credit

# Database options
DATABASE_POOL_SIZE=10
DATABASE_ECHO=False
DATABASE_TIMEOUT=30

# MODEL PATHS (Optional - uses defaults if not specified)
# =====================================================================
# Path to IndicTrOCR model (default: backend/models/indic_trocr)
INDIC_TROCR_PATH=backend/models/indic_trocr

# Path to IndicTrans2 model (default: backend/models/indictrans2)
INDICTRANS2_PATH=backend/models/indictrans2

# DATASET PATHS
# =====================================================================
# Path to OCR dataset (default: backend/datasets/indic_ocr_dataset)
DATASET_PATH=backend/datasets/indic_ocr_dataset

# Path to images directory
IMAGES_PATH=backend/datasets/indic_ocr_dataset/images

# Path to ground truth labels directory
LABELS_PATH=backend/datasets/indic_ocr_dataset/labels

# GPU CONFIGURATION
# =====================================================================
# CUDA device ID (0 for first GPU, or -1 for CPU)
CUDA_VISIBLE_DEVICES=0

# Device type: cuda or cpu
INFERENCE_DEVICE=cuda

# GPU Memory settings (in MB)
GPU_MEMORY_LIMIT=4048

# MODEL CONFIGURATION
# =====================================================================
# Transformer model cache directory
TRANSFORMERS_CACHE=backend/.cache/transformers

# Number of beams for translation search
TRANSLATION_NUM_BEAMS=5

# Maximum sequence length for models
MAX_SEQUENCE_LENGTH=512

# PROCESSING CONFIGURATION
# =====================================================================
# Batch size for processing multiple documents
BATCH_SIZE=32

# Maximum workers for parallel processing
MAX_WORKERS=4

# Output directory for results
OUTPUT_DIR=backend/output

# Enable detailed logging
DEBUG_MODE=True

# PIPELINE CONFIGURATION
# =====================================================================
# Source language code (hin, tel, tam, ben, mar, guj, kan, mal, pan, urd, eng)
SOURCE_LANGUAGE=hin

# Target language code
TARGET_LANGUAGE=eng

# Save intermediate results
SAVE_INTERMEDIATE=True

# Compute OCR accuracy metrics
COMPUTE_OCR_METRICS=True

# Store to database
USE_DATABASE=True

# API CONFIGURATION (if using FastAPI server)
# =====================================================================
# API host
API_HOST=0.0.0.0

# API port
API_PORT=8000

# API workers
API_WORKERS=4

# Enable CORS
CORS_ENABLED=True

# CORS origins
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# LOGGING CONFIGURATION
# =====================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=backend/logs/pipeline.log

# Log max size (MB)
LOG_MAX_SIZE=10

# Number of log backups
LOG_BACKUP_COUNT=5

# MONITORING AND METRICS
# =====================================================================
# Enable performance monitoring
ENABLE_MONITORING=True

# Metrics collection interval (seconds)
METRICS_INTERVAL=60

# Prometheus metrics port
PROMETHEUS_PORT=8001

# SECURITY
# =====================================================================
# API key for authentication (if implementing)
API_KEY=your_secure_api_key_here

# Database credentials file (alternative to DATABASE_URL)
DB_CREDENTIALS_FILE=backend/.db_credentials

# Enable request validation
VALIDATE_REQUESTS=True

# DOCUMENT STORAGE
# =====================================================================
# Store processed documents
STORE_DOCUMENTS=True

# Archive old documents (in days)
ARCHIVE_DOCUMENTS_AFTER=90

# Maximum documents to keep
MAX_STORED_DOCUMENTS=10000

# ============================================================================
# PYTHON USAGE OF CONFIGURATION
# ============================================================================

# Method 1: Using environment variables
# ============================================================================
import os
from backend.pipeline import DocumentProcessingPipeline

database_url = os.getenv('DATABASE_URL', 'postgresql://localhost/intelli_credit')
device = os.getenv('INFERENCE_DEVICE', 'cuda')
source_lang = os.getenv('SOURCE_LANGUAGE', 'hin')

pipeline = DocumentProcessingPipeline(
    database_url=database_url,
    device=device
)

# Method 2: Using python-dotenv
# ============================================================================
from dotenv import load_dotenv
import os

# Load from .env file
load_dotenv('backend/.env')

DATABASE_URL = os.getenv('DATABASE_URL')
DEVICE = os.getenv('INFERENCE_DEVICE', 'cuda')
BATCH_SIZE = int(os.getenv('BATCH_SIZE', '32'))

# Method 3: Using pydantic Settings
# ============================================================================
from pydantic_settings import BaseSettings
from typing import Optional

class Settings(BaseSettings):
    # Database
    database_url: str = 'postgresql://postgres:password@localhost:5432/intelli_credit'
    database_pool_size: int = 10
    
    # Models
    indic_trocr_path: str = 'backend/models/indic_trocr'
    indictrans2_path: str = 'backend/models/indictrans2'
    
    # Processing
    inference_device: str = 'cuda'
    batch_size: int = 32
    source_language: str = 'hin'
    target_language: str = 'eng'
    
    # Logging
    log_level: str = 'INFO'
    debug_mode: bool = False
    
    class Config:
        env_file = '.env'
        env_file_encoding = 'utf-8'
        case_sensitive = False

settings = Settings()

# Method 4: Configuration Class
# ============================================================================
from dataclasses import dataclass
from typing import Optional

@dataclass
class PipelineConfig:
    """Pipeline configuration"""
    
    # Database
    database_url: str = 'postgresql://localhost/intelli_credit'
    
    # Models
    ocr_model_path: Optional[str] = None  # Uses default if None
    translation_model_path: Optional[str] = None
    dataset_path: Optional[str] = None
    
    # Processing
    device: str = 'cuda'
    batch_size: int = 32
    num_workers: int = 4
    
    # Languages
    source_language: str = 'hin'
    target_language: str = 'eng'
    
    # Features
    compute_metrics: bool = True
    use_database: bool = True
    save_results: bool = True
    
    # Logging
    debug_mode: bool = False
    log_level: str = 'INFO'

# Usage
config = PipelineConfig(
    database_url='postgresql://user:pass@localhost:5432/db',
    device='gpu',
    batch_size=16
)

# Method 5: YAML Configuration
# ============================================================================
# File: config.yaml
"""
pipeline:
  database:
    url: postgresql://localhost/intelli_credit
    pool_size: 10
    timeout: 30
  
  models:
    ocr_path: backend/models/indic_trocr
    translation_path: backend/models/indictrans2
    
  processing:
    device: cuda
    batch_size: 32
    num_workers: 4
    
  languages:
    source: hin
    target: eng
    
  features:
    compute_metrics: true
    use_database: true
    save_results: true

logging:
  level: INFO
  file: backend/logs/pipeline.log
"""

# Python code to load YAML
import yaml

with open('config.yaml', 'r') as f:
    config = yaml.safe_load(f)

database_url = config['pipeline']['database']['url']
device = config['pipeline']['processing']['device']

# ============================================================================
# MULTI-ENVIRONMENT CONFIGURATION
# ============================================================================

# development.env
"""
DATABASE_URL=postgresql://dev:dev@localhost:5432/dev_db
INFERENCE_DEVICE=cpu
LOG_LEVEL=DEBUG
DEBUG_MODE=True
"""

# production.env
"""
DATABASE_URL=postgresql://prod_user:secure_pass@prod.db.server:5432/prod_db
INFERENCE_DEVICE=cuda
LOG_LEVEL=WARNING
DEBUG_MODE=False
GPU_MEMORY_LIMIT=8192
"""

# staging.env
"""
DATABASE_URL=postgresql://staging:staging@staging.db:5432/staging_db
INFERENCE_DEVICE=cuda
LOG_LEVEL=INFO
DEBUG_MODE=False
"""

# Usage
import os
from dotenv import load_dotenv

env = os.getenv('ENVIRONMENT', 'development')
load_dotenv(f'backend/.env.{env}')

# ============================================================================
# COMMAND-LINE CONFIGURATION
# ============================================================================

# Using argparse
import argparse

parser = argparse.ArgumentParser(description='OCR Pipeline')
parser.add_argument('--device', default='cuda', help='cuda or cpu')
parser.add_argument('--batch-size', type=int, default=32)
parser.add_argument('--database-url', help='PostgreSQL connection string')
parser.add_argument('--source-lang', default='hin')
parser.add_argument('--target-lang', default='eng')

args = parser.parse_args()

# Usage
"""
python pipeline.py \\
    --device cuda \\
    --batch-size 16 \\
    --database-url postgresql://user:pass@localhost/db \\
    --source-lang tel \\
    --target-lang eng
"""

print(f"Device: {args.device}")
print(f"Batch Size: {args.batch_size}")
print(f"Database: {args.database_url}")

# ============================================================================
# DOCKER CONFIGURATION
# ============================================================================

# Dockerfile example
"""
FROM python:3.10-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY . .

ENV DATABASE_URL=postgresql://postgres:password@db:5432/intelli_credit
ENV INFERENCE_DEVICE=cpu
ENV LOG_LEVEL=INFO

CMD ["python", "backend/pipeline.py"]
"""

# docker-compose.yml example
"""
version: '3.8'

services:
  postgres:
    image: postgres:15-alpine
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: password
      POSTGRES_DB: intelli_credit
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data

  pipeline:
    build: .
    depends_on:
      - postgres
    environment:
      DATABASE_URL: postgresql://postgres:password@postgres:5432/intelli_credit
      INFERENCE_DEVICE: cpu
      LOG_LEVEL: INFO
    volumes:
      - ./backend/datasets:/app/backend/datasets
      - ./backend/output:/app/backend/output

volumes:
  postgres_data:
"""

# Setup: docker-compose up

# ============================================================================
# Useful Configuration Combinations
# ============================================================================

# Fast development setup (CPU)
"""
INFERENCE_DEVICE=cpu
LOG_LEVEL=DEBUG
DEBUG_MODE=True
BATCH_SIZE=1
"""

# Production setup (GPU)
"""
INFERENCE_DEVICE=cuda
LOG_LEVEL=WARNING
DEBUG_MODE=False
BATCH_SIZE=32
GPU_MEMORY_LIMIT=8192
"""

# High-precision setup
"""
INFERENCE_DEVICE=cuda
TRANSLATION_NUM_BEAMS=10
MAX_SEQUENCE_LENGTH=512
COMPUTE_OCR_METRICS=True
"""

# Lightweight setup (CPU, minimal memory)
"""
INFERENCE_DEVICE=cpu
BATCH_SIZE=1
MAX_WORKERS=1
TRANSLATION_NUM_BEAMS=3
LOG_LEVEL=WARNING
"""
